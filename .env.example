# Shopify (from Partner Dashboard / CLI)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_themes
SHOPIFY_APP_URL=

# Local dev: SQLite file in prisma/
DATABASE_URL=file:./dev.sqlite

# Production (Turso) — also set these on Vercel
TURSO_DATABASE_URL=libsql://<database>-<org>.<region>.turso.io
TURSO_AUTH_TOKEN=

# Optional: Partner API (Shopify App Pricing source of truth)
# Partner Dashboard → Settings → Partner API clients → Manage apps
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
